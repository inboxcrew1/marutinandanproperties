# Apache / LiteSpeed Rules for Shree Maruti Nandan Properties
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://shreemarutinandanproperties.com/$1 [L,R=301]

  # 2. Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.shreemarutinandanproperties\.com$ [NC]
  RewriteRule ^(.*)$ https://shreemarutinandanproperties.com/$1 [L,R=301]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>
